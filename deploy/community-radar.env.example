# Listens on the LAN, protected against DNS rebinding by the list of allowed hosts.
RADAR_HOST=0.0.0.0
RADAR_PORT=8000
RADAR_ALLOWED_HOSTS=192.168.1.214:8000,community-radar:8000
RADAR_CACHE_TTL=900
# Read-only GitHub token (fine-grained, public repositories): lifts the 60 requests/hour limit.
GITHUB_TOKEN=
# Reddit "script" app for the official API (optional, RSS fallback otherwise).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
