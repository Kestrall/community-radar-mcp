# Listens on the LAN, protected against DNS rebinding by the list of allowed hosts.
RADAR_HOST=0.0.0.0
RADAR_PORT=8000
RADAR_ALLOWED_HOSTS=192.168.1.214:8000,community-radar:8000
RADAR_CACHE_TTL=900
# Read-only GitHub token (fine-grained, public repositories): lifts the 60 requests/hour limit.
GITHUB_TOKEN=
# Reddit "script" app for the official API, once access is approved (optional: Reddit is off without it).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Discord: a bot invited by the server admins (View Channels + Read Message History, Message Content intent).
# Optional: Discord is off without the token and the server id.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: only these channels (names or ids, comma-separated); default: every channel the bot can read.
DISCORD_CHANNELS=
# Optional: regular expression on role names that mark staff (default: staff|team|ovhcloud|admin|modo|moderat).
DISCORD_STAFF_ROLES=
